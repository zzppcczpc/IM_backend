# 纯IM系统环境配置示例

# MongoDB连接
DATABASE_URL=mongodb://localhost:27017

# JWT密钥（生产环境请更改）
SECRET_KEY=your-secret-key-change-in-production

# AES加密密钥（32字节）
SECRET_ENCRYPTION_KEY=your-32-byte-encryption-key

# AES IV（16字节）
SECRET_IV=your-16-byte-iv

# 是否开启API文档
OPENAPI_DOCS=True

# 文件上传限制
MAX_FILE_SIZE=10485760

# AI服务配置（OpenAI-compatible接口；阿里百炼可使用 https://dashscope.aliyuncs.com/compatible-mode/v1）
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=your-ai-api-key
AI_MODEL_NAME=qwen-plus
AI_HEALTHCHECK_TIMEOUT=10

# 图片文本化配置（使用支持视觉输入的 OpenAI-compatible 模型）
VISION_MODEL_NAME=qwen-vl-plus
VISION_MAX_TOKENS=1024
MULTIMODAL_TIMEOUT=120

# 音频文本化配置（讯飞长语音识别）
ASR_IFLYTEK_URL=https://raasr.xfyun.cn/v2/api
ASR_POLL_INTERVAL=5
ASR_POLL_TIMEOUT=300
XF_APPID=your-iflytek-app-id
XF_ASR_SECRET_KEY=your-iflytek-secret-key

# 知识库 Embedding 配置
EMBEDDING_PROVIDER=local_bge_m3
BGE_M3_MODEL_NAME=BAAI/bge-m3
BGE_M3_DEVICE=auto
BGE_M3_USE_FP16=False
EMBEDDING_BATCH_SIZE=8

# Milvus 配置
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_FILE_CHUNKS_COLLECTION=file_chunks
MILVUS_CONNECT_TIMEOUT=5
